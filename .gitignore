# Секреты. Ничего из перечисленного не должно попадать в репозиторий: он публичный,
# и один раз закоммиченный ключ считается скомпрометированным навсегда — удаление
# файла следующим коммитом не помогает, старая версия остаётся в истории.
serviceAccountKey.json
*serviceAccount*.json
.env
.env.*
.dev.vars
*.pem
*.key

# Локальное состояние wrangler (в нём кэшируются в том числе секреты воркера)
.wrangler/

node_modules/

# Локальный инструмент для апскейла фото (exe + веса нейросети, Windows-бинарник,
# ~45 МБ) — используется вручную из scripts/, сайту не нужен, в репозиторий не идёт.
scripts/rvk/
